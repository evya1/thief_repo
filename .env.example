# Safe placeholders only. The application does NOT auto-load .env; export values in the shell.
GROUP_CODE=ZeroOne0
TEAM_NAME=ZeroOne
TEAM_NUMBER=01
TEAM_GITHUB_HANDLES=evya1,Us5rName
THIEF_REPOSITORY_URL=https://github.com/evya1/thief_repo
SIBLING_REPOSITORY_URL=https://github.com/evya1/police_repo
PUBLIC_MCP_URL=<PUBLIC_MCP_URL>
OPPONENT_MCP_URL=<OPPONENT_MCP_URL>
GMAIL_OAUTH_CLIENT_FILE=<LOCAL_PATH_TO_CREDENTIALS_JSON>
GMAIL_OAUTH_TOKEN_FILE=<LOCAL_PATH_TO_TOKEN_JSON>
