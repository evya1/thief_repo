GMAIL_TEST_RECIPIENT=<LOCAL_TEST_RECIPIENT>
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Opt-in live smoke test only
RUN_LIVE_OPENROUTER_TESTS=0
OPENROUTER_SMOKE_MODEL=deepseek/deepseek-v4-flash-0731:nitro
