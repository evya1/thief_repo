# Local private configuration example (EXAMPLE — NOT AN OFFICIAL ATTACHED TEMPLATE)
min_center_intensity = 0.5
group_id = "local-team"
seed = 42

[network]
turn_timeout = 30.0
connect_timeout = 30.0
poll_interval = 0.01

[strategy]
# Optional brain override: dotted "package.module:ClassName" (FR-T9).
# Unset => the shipped ThiefBrain runs.
# thief_class = "my_team.strategy:CustomThiefBrain"

[strategy.thief]
# PLANQ-008 approval baseline (PRD_thief_strategy.md §9); all optional.
w_dist = 1.0
w_mob = 0.25
w_fresh = 0.15
# w_trap penalises a destination flagged by the SHIPPED predicate
# `strategy/scoring.py:trap_risk(mobility <= 1)`: at most one orthogonal exit
# left, so one further barrier could seal it. That is a conservative POLICY
# heuristic, not the domain's rule-47 capture test (`Board.boxed_in`, zero
# exits) — `boxed_in` can never be true at a destination just moved to, since
# the vacated origin is still an open neighbour.
w_trap = 5.0
min_confidence = 0.15

# Optional verbal-hint provider (T027, P2, gated by PLANQ-003/004).
# Default ``template`` is free/offline and requires no key. ``openai_api``
# (OpenAI Chat Completions) needs OPENAI_API_KEY in the environment at
# runtime; ``ollama`` talks to a local model. Any failure degrades to the
# deterministic template. Never on the movement path (STRAT-008).
#[trash_talk]
#provider = "template"        # template | openai_api | ollama
#model = "gpt-4o-mini"        # only for openai_api (or local model for ollama)
#every_n_steps = 1
#ollama_url = "http://localhost:11434/api/generate"
