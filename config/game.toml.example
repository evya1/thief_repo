# Local private configuration example (EXAMPLE -- NOT AN OFFICIAL ATTACHED TEMPLATE)
#
# config/game.json is the signed constitution both peers must load byte for byte. This file is
# its opposite: local, private, never signed, and never on the wire -- except for the small
# identity subset the greeting carries deliberately.
#
# The book's own test decides which file a value belongs in: "would the opponent have to agree
# to this, or rely on it?" If yes, it goes in the shared JSON. If no, it goes here. The shared
# JSON wins on every shared key, so nothing written here can weaken a signed condition.
#
# NEVER put a secret in this file. credentials.json and token.json are referenced by path, are
# git-ignored, and their contents are never read into any artifact.

min_center_intensity = 0.5
seed = 42

[game]
group_name = "ZeroOne"
group_id = "ZeroOne0"
# Publication-intended member identifiers only. Never legal names or government identifiers.
members = ["id-1001", "id-1002"]
# BOTH repositories, declared by both peers (App. E rule 49).
repos = { cop = "https://github.com/evya1/police_repo", thief = "https://github.com/evya1/thief_repo" }

[network]
my_port = 8102                                  # the port MY FastMCP server binds
opponent_url = "http://127.0.0.1:8101/mcp"      # the only thing I know about the opponent
# public_url = "https://<your-tunnel>.ngrok-free.app/mcp"   # set for league play (rule 10)
turn_timeout_seconds = 180

[llm]
# The move is ALWAYS decided in Python. The language model touches the verbal layer only.
provider = "template"                           # template | openrouter
model = "deepseek/deepseek-v4-flash-0731:nitro" # required only when openrouter is enabled
# provider_slug = "novita"                      # optional explicit provider pin; omit for Nitro
step_deadline_seconds = 30
max_output_tokens = 32
every_n_steps = 1

[email]
# Official counted-report destination from project book v3.0.0.
recipient = "rmisegal+uoh26finalgame@gmail.com"
# "dry-run" composes the message and writes it to the bundle's outbox without sending.
# A real send additionally requires an explicit human authorisation flag.
mode = "dry-run"

# [strategy] -- optional: point at YOUR brain subclass (else the shipped heuristic runs)
# thief_class = "my_team.strategy:MyThiefBrain"

[strategy.thief]
# PLANQ-008 approved production weight vector. These explicit values keep the example used by
# the KPI harness identical to the configuration a real peer loads.
w_dist = 1.0
w_mob = 0.25
w_fresh = 0.15
w_trap = 5.0
min_confidence = 0.15
